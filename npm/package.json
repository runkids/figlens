{
  "name": "@runkids/figlens",
  "version": "0.10.0",
  "description": "Read local Figma designs with CLI, MCP, Pi, OpenCode and OMP integrations.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/runkids/figlens.git"
  },
  "homepage": "https://github.com/runkids/figlens",
  "keywords": [
    "figma",
    "fig",
    "design-to-code",
    "cli",
    "ai",
    "pi-package"
  ],
  "bin": {
    "figlens": "bin/figlens.js"
  },
  "files": [
    "bin/",
    "target.js",
    "pi/",
    "skills/",
    "opencode/",
    "omp/",
    ".mcp.json"
  ],
  "pi": {
    "extensions": [
      "./pi/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "image": "https://raw.githubusercontent.com/runkids/figlens/main/assets/taskflow-demo-poster.jpg",
    "video": "https://raw.githubusercontent.com/runkids/figlens/main/assets/taskflow-demo.mp4"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@earendil-works/pi-tui": "*",
    "typebox": "*",
    "@oh-my-pi/pi-coding-agent": "^18.13.2",
    "@oh-my-pi/pi-tui": "*",
    "@opencode/plugin": "2.2.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    },
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    },
    "@oh-my-pi/pi-tui": {
      "optional": true
    },
    "@opencode/plugin": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "arm64",
    "x64"
  ],
  "omp": {
    "extensions": [
      "./omp/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "exports": {
    ".": "./opencode/index.mjs",
    "./tui": "./opencode/tui.mjs",
    "./rpc": "./opencode/rpc.mjs",
    "./package.json": "./package.json"
  }
}
