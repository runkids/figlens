{
  "name": "@runkids/figlens",
  "version": "0.3.0",
  "description": "Read .fig designs offline. Local preview, CLI + MCP, and reviewed project component mappings for Pi.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/runkids/figlens.git"
  },
  "homepage": "https://github.com/runkids/figlens",
  "keywords": [
    "figma",
    "fig",
    "design-to-code",
    "cli",
    "ai",
    "pi-package"
  ],
  "bin": {
    "figlens": "bin/figlens.js"
  },
  "files": [
    "bin/",
    "target.js",
    "pi/"
  ],
  "pi": {
    "extensions": [
      "./pi/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/runkids/figlens/main/assets/pi-demo-poster.png",
    "video": "https://raw.githubusercontent.com/runkids/figlens/main/assets/pi-demo.mp4"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "arm64",
    "x64"
  ]
}
