# Pinned by digest: release binaries must not change under a moved tag.
FROM rust:1.97.1@sha256:b1b3c9c0d921d7fa0a6d1f9ec7e4eab87f8c8ec97644c3d791450f131dec813f

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3-venv \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv /opt/cross \
    && /opt/cross/bin/pip install --no-cache-dir cargo-zigbuild==0.23.4 ziglang==0.15.2 \
    && rustup target add aarch64-apple-darwin x86_64-apple-darwin \
        x86_64-unknown-linux-musl aarch64-unknown-linux-musl x86_64-pc-windows-gnu

ENV PATH="/opt/cross/bin:${PATH}"
