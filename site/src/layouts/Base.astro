---
import '@fontsource-variable/schibsted-grotesk';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/global.css';
import { Image } from 'astro:assets';
import logo from '../assets/logo.webp';
import { REPO } from '../data';
import { SITE, hrefOf } from '../docs';
import { LOCALES, LANG_NAMES } from '../i18n';

interface Props { title: string; description: string; path: string; jsonLd?: object; active?: 'home' | 'docs' | 'none'; lang?: string; alternates?: { lang: string; href: string }[]; docsHref?: string; skip?: string; noindex?: boolean }
const { title, description, path, jsonLd, active = 'home', lang = 'en', alternates = [], docsHref = '/docs/', skip, noindex = false } = Astro.props;
const xDefault = alternates.find((a) => a.lang === 'en');
const url = SITE + path;
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={url} />}
  {alternates.length > 1 && alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={SITE + a.href} />)}
  {alternates.length > 1 && xDefault && <link rel="alternate" hreflang="x-default" href={SITE + xDefault.href} />}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt" />
  <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
  <meta property="og:type" content={active === 'docs' ? 'article' : 'website'} />
  <meta property="og:site_name" content="figlens" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={url} />
  <meta property="og:locale" content={lang.replace('-', '_')} />
  <meta property="og:image" content={`${SITE}/og.png`} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={`${SITE}/og.png`} />
  <meta name="theme-color" content="#f5f5f2" />
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
</head>
<body>
  <a class="skip" href={active === 'home' ? '#install' : '#doc'}>{skip ?? (active === 'home' ? 'Skip to install' : 'Skip to content')}</a>

  <header class="nav">
    <a class="brand" href="/"><Image src={logo} alt="figlens" width={132} height={44} loading="eager" /></a>
    <nav aria-label="Site">
      <a href="/#how">How it works</a>
      <a href={docsHref} aria-current={active === 'docs' ? 'page' : undefined}>Docs</a>
      <a href="/#install">Install</a>
      <a class="nav-gh" href={REPO}>GitHub</a>
    </nav>
  </header>

  <slot />

  <footer class="footer">
    <p><a href={REPO}>GitHub</a> · <a href="/docs/">Docs</a> · <a href={`${REPO}/releases`}>Releases</a> · <a href="/llms.txt">llms.txt</a> · MIT license</p>
    <p class="footer-langs"><span>Docs:</span> {LOCALES.map((l) => <a href={hrefOf(l, '')} hreflang={l} lang={l} aria-current={l === lang && active === 'docs' ? 'true' : undefined}>{LANG_NAMES[l]}</a>)}</p>
    <p class="fine">figlens is an independent project, not affiliated with, endorsed by or sponsored by Figma. Use only files you have permission to access and share.</p>
  </footer>
</body>
</html>
